    "lucide-react": "^0.525.0",
    "motion": "^12.23.0",
    "next": "16.4.6",
    "postcss": "^8.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.11"
  },
